<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1707: underscores in test names; CA1848/CA1873: LoggerMessage perf (later); CA2007: ConfigureAwait not needed in ASP.NET Core -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA2007;CA1515;CA1031;CA1303;CA1716;CA1711;CA1819;CA1002;CA2227;CA1056;CA1054;CA1062;CA1724;CA1034;CA5394;CA1308;CA1305;CA1307;CA1309;CA1310;CA1861;CA1812;CA1851;CA1859;CA2201;CA1000;CA2225</NoWarn>
  </PropertyGroup>
</Project>

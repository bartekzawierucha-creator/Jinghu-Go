{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Postgres"
  },
  "GameConfig": {
    "CharacterCreationPath": "game-config/character-creation.json",
    "CultivationPath": "game-config/cultivation.json"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "GlobalPermitsPerMinute": 300
  },
  "Identity": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "MaxFailedLogins": 5,
    "LockoutDuration": "00:15:00"
  },
  "ConnectionStrings": {
    "Jianghu": "Host=localhost;Database=jianghu;Username=jianghu;Maximum Pool Size=50"
  },
  "Worker": {
    "RunInProcess": false
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "MaxAttempts": 8,
    "MaxBackoff": "00:10:00",
    "MaxHealthyLag": "00:05:00"
  },
  "RealWorld": {
    "Enabled": true
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "InMemory"
  },
  "GameConfig": {
    "CharacterCreationPath": "game-config/character-creation.json"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "GlobalPermitsPerMinute": 300
  },
  "Identity": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "MaxFailedLogins": 5,
    "LockoutDuration": "00:15:00"
  }
}

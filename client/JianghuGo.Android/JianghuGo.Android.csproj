<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native Android client (.NET for Android) — builds an APK without Unity.
    Reuses the engine-independent client core (ApiClient + flows), the same code the integration tests run against
    the real server; only the platform layer (UI, GPS, token storage, JSON) lives here.
    Build: dotnet workload install android; dotnet publish -f net10.0-android -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>JianghuGo.Android</RootNamespace>
    <ApplicationId>pl.bz.jianghugo</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- System.Text.Json, minimal APIs and DI use reflection over the client and the embedded server. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Trim only the base class library (partial mode); the app, the client core, the embedded server and ASP.NET Core
         are rooted below because they are used through reflection. Keeps each APK small enough to download easily. -->
    <TrimMode>partial</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- -p:Abi=android-arm64 builds an APK for one CPU type only (CI builds one per type) -->
    <RuntimeIdentifiers Condition="'$(Abi)' == ''">android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(Abi)' != ''">$(Abi)</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../JianghuGo.Client.Core.csproj" />
  </ItemGroup>
  <!--
    Offline mode embeds the game server. Its assemblies (and ASP.NET Core's, which has no Android runtime pack) are
    plain IL and are referenced as files: ServerBin = `dotnet publish server/src/Api -o …`,
    AspNetDir = the Microsoft.AspNetCore.App shared framework folder of the SDK that built it.
  -->
  <ItemGroup Condition="'$(ServerBin)' != '' And '$(AspNetDir)' != ''">
    <Reference Include="$(AspNetDir)/*.dll" Private="true" />
    <Reference Include="$(ServerBin)/*.dll" Exclude="$(ServerBin)/JianghuGo.*Tests*.dll" Private="true" />
    <_EmbeddedServerDll Include="$(AspNetDir)/*.dll;$(ServerBin)/*.dll" />
    <TrimmerRootAssembly Include="@(_EmbeddedServerDll->'%(Filename)')" RootMode="All" />
    <TrimmerRootAssembly Include="JianghuGo.Client.Core" RootMode="All" />
    <AndroidAsset Include="../../content/game-config/*.json" Link="Assets/game-config/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../server/src/Api/appsettings.json" Link="Assets/appsettings.json" />
  </ItemGroup>
  <Target Name="RequireServer" BeforeTargets="Build" Condition="'$(ServerBin)' == '' Or '$(AspNetDir)' == ''">
    <Error Text="Set ServerBin and AspNetDir (see the comment in JianghuGo.Android.csproj)." />
  </Target>
</Project>

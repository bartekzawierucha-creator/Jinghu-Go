<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native Android client (.NET for Android) — builds an APK without Unity.
    Reuses the engine-independent client core (ApiClient + flows), the same code the integration tests run against
    the real server; only the platform layer (UI, GPS, token storage, JSON) lives here.
    Build: dotnet workload install android; dotnet publish -f net10.0-android -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>JianghuGo.Android</RootNamespace>
    <ApplicationId>pl.bz.jianghugo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.9.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- System.Text.Json, minimal APIs and DI use reflection over the client and the embedded server: no trimming. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <!-- one APK per CPU type: a phone downloads only its own (arm64 for nearly all current phones) -->
    <AndroidCreatePackagePerAbi>true</AndroidCreatePackagePerAbi>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../JianghuGo.Client.Core.csproj" />
  </ItemGroup>
  <!--
    Offline mode embeds the game server. Its assemblies (and ASP.NET Core's, which has no Android runtime pack) are
    plain IL and are referenced as files: ServerBin = `dotnet publish server/src/Api -o …`,
    AspNetDir = the Microsoft.AspNetCore.App shared framework folder of the SDK that built it.
  -->
  <ItemGroup Condition="'$(ServerBin)' != '' And '$(AspNetDir)' != ''">
    <Reference Include="$(AspNetDir)/*.dll" Private="true" />
    <Reference Include="$(ServerBin)/*.dll" Exclude="$(ServerBin)/JianghuGo.*Tests*.dll" Private="true" />
    <AndroidAsset Include="../../content/game-config/*.json" Link="Assets/game-config/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../server/src/Api/appsettings.json" Link="Assets/appsettings.json" />
  </ItemGroup>
  <Target Name="RequireServer" BeforeTargets="Build" Condition="'$(ServerBin)' == '' Or '$(AspNetDir)' == ''">
    <Error Text="Set ServerBin and AspNetDir (see the comment in JianghuGo.Android.csproj)." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs thousands of AI-vs-AI battles with the real engine and rules files; prints win rates and battle length. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../server/src/Modules/Combat/JianghuGo.Modules.Combat.csproj" />
  </ItemGroup>
</Project>

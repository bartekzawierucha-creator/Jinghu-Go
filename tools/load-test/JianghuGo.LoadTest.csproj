<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HTTP load generator: N virtual players run realistic sessions against a running API (register, create a character,
    then loop over reads, meditation, market browsing and PvE turns). Reports latency percentiles per operation and
    fails (exit 1) when the error rate or p95 exceeds the given budget. Run against a dedicated environment only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>

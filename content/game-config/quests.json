  "story": [
    {"id": "story_1", "number": 1, "titlePl": "Przebudzenie", "textPl": "Budzisz się w ruinach spalonej wioski. Stary mnich, który cię ocalił, mówi, że w twoich meridianach płynie coś, czego nie powinno tam być. Zanim odejdzie, każe ci walczyć.", "goalPl": "Wygraj 3 walki.", "metric": "battles_won", "target": 3, "stones": 100},
    {"id": "story_2", "number": 2, "titlePl": "Oddech świata", "textPl": "Mnich uczy cię, że Qi jest wszędzie — w rosie, w kamieniach, w krokach. Wyjdź w świat i zbierz je.", "goalPl": "Zbierz Qi w świecie 5 razy.", "metric": "world_qi", "target": 5, "stones": 120, "item": "qi_pill", "itemQuantity": 3},
    {"id": "story_3", "number": 3, "titlePl": "Pierwszy przełom", "textPl": "Zbierasz Qi szybciej niż ktokolwiek, kogo mnich znał. Czas sprawdzić, czy twoje ciało wytrzyma pierwszy przełom.", "goalPl": "Dokonaj 2 przełomów.", "metric": "breakthroughs", "target": 2, "stones": 200},
    {"id": "story_4", "number": 4, "titlePl": "Cień w lesie", "textPl": "We wsi mówią o bestiach, które wychodzą z lasu nocą. Ktoś je wypędza z gór — ktoś, kto szuka tego samego, co ty.", "goalPl": "Wygraj 15 walk.", "metric": "battles_won", "target": 15, "stones": 250, "item": "ember_trace", "itemQuantity": 5},
    {"id": "story_5", "number": 5, "titlePl": "Ślady żaru", "textPl": "W popiołach twojej wioski znajdujesz ślady żaru, które nie gasną. To nie był zwykły pożar. Ktoś szukał płomienia.", "goalPl": "Pokonaj ducha płomienia.", "metric": "spirits_won", "target": 1, "stones": 400},
    {"id": "story_6", "number": 6, "titlePl": "Wieża Prób", "textPl": "Mnich prowadzi cię do Wieży Prób. 'Kto chce poznać prawdę o twojej wiosce, musi najpierw poznać siebie.'", "goalPl": "Pokonaj 5 pięter Wieży.", "metric": "tower_won", "target": 5, "stones": 500, "item": "breakthrough_pill_mortal", "itemQuantity": 1},
    {"id": "story_7", "number": 7, "titlePl": "Złoty Rdzeń", "textPl": "Twoje Qi gęstnieje. Wróg, który spalił wioskę, był kultywatorem Złotego Rdzenia — musisz mu dorównać.", "goalPl": "Osiągnij Złoty Rdzeń.", "metric": "realm", "target": 4, "stones": 800},
    {"id": "story_8", "number": 8, "titlePl": "Arena Jianghu", "textPl": "Ślad prowadzi do miasta, w którym kultywatorzy walczą o sławę. Ktoś na arenie nosi znak twojego wroga.", "goalPl": "Wygraj 10 walk na arenie.", "metric": "arena_won", "target": 10, "stones": 900},
    {"id": "story_9", "number": 9, "titlePl": "Gniew nieba", "textPl": "Niebo patrzy. Każdy, kto sięga zbyt wysoko, musi przetrwać jego gniew. Twój wróg już go przetrwał.", "goalPl": "Przetrwaj niebiańską próbę.", "metric": "tribulations", "target": 1, "stones": 1200},
    {"id": "story_10", "number": 10, "titlePl": "Smok w chmurach", "textPl": "Twój wróg służy Bossowi Świata — prastaremu stworzeniu, które budzi się co dzień. Stań przed nim.", "goalPl": "Walcz 5 razy z Bossem Świata.", "metric": "world_boss_fights", "target": 5, "stones": 1500, "item": "body_transcendence_pill", "itemQuantity": 1},
    {"id": "story_11", "number": 11, "titlePl": "Narodziny Duszy", "textPl": "Prawda jest blisko. Aby ją unieść, twoja dusza musi narodzić się na nowo.", "goalPl": "Osiągnij Narodzoną Duszę.", "metric": "realm", "target": 5, "stones": 2000},
    {"id": "story_12", "number": 12, "titlePl": "Płomień, który cię wybrał", "textPl": "Rozumiesz już: to nie wróg szukał płomienia — to płomień szukał ciebie. Pochłoń go i zakończ tę historię.", "goalPl": "Pochłoń 3 niebiańskie płomienie.", "metric": "flames_owned", "target": 3, "stones": 3000, "item": "breakthrough_pill_immortal", "itemQuantity": 1},
    {"id": "story_13", "number": 13, "titlePl": "Księga II: Brama Nieśmiertelnych", "textPl": "Płomień zaprowadził cię dalej, niż sięga pamięć wioski. Za Bramą Nieśmiertelnych czeka świat, w którym śmierć jest tylko plotką.", "goalPl": "Wkrocz w erę nieśmiertelnych.", "metric": "realm", "target": 11, "stones": 6000, "item": "spirit_marrow_pill", "itemQuantity": 2},
    {"id": "story_14", "number": 14, "titlePl": "Szepty z Wieży", "textPl": "Mnisi mówią, że na setnym piętrze Wieży Prób leży kanon, który spisały spadające gwiazdy.", "goalPl": "Wygraj 100 walk w Wieży Prób.", "metric": "tower_won", "target": 100, "stones": 9000, "item": "manual_starfall_canon", "itemQuantity": 1},
    {"id": "story_15", "number": 15, "titlePl": "Era Świętych", "textPl": "Święci nie walczą — oni rozstrzygają. Dorośnij do ich spojrzenia.", "goalPl": "Wkrocz w erę świętych.", "metric": "realm", "target": 22, "stones": 15000, "item": "saint_blood_pill", "itemQuantity": 1},
    {"id": "story_16", "number": 16, "titlePl": "Dwanaście Ogni", "textPl": "Każdy płomień, który pochłonąłeś, pamięta swoją historię. Zbierz dwanaście, a usłyszysz, jak mówią jednym głosem.", "goalPl": "Posiądź 12 niebiańskich płomieni.", "metric": "flames_owned", "target": 12, "stones": 25000, "item": "heaven_marrow_pill", "itemQuantity": 1},
    {"id": "story_17", "number": 17, "titlePl": "Wieczność", "textPl": "Czas przestał cię dotyczyć. Teraz to ty jesteś miarą lat.", "goalPl": "Wkrocz w erę wiecznych.", "metric": "realm", "target": 44, "stones": 50000, "item": "phoenix_ash_pill", "itemQuantity": 2},
    {"id": "story_18", "number": 18, "titlePl": "Źródło Dao", "textPl": "Na końcu drogi nie ma wroga ani nauczyciela. Jest tylko Dao — i ty.", "goalPl": "Osiągnij Jedność z Dao.", "metric": "realm", "target": 65, "stones": 200000, "item": "primordial_essence_pill", "itemQuantity": 3}

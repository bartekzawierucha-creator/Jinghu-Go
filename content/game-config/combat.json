  "pathPerks": {
    "qi": {"descriptionPl": "Ładunek Qi: co turę +15, przy odpoczynku i gardzie +20; pełny (100) sprawia, że następna technika Ducha zadaje +80%, przebija gardę i zdejmuje wzmocnienie wroga (ogłuszenie zeruje ładunek). Do tego +25% maks. Qi, +4 Qi co turę, techniki Ducha +18%, osłony +6 pkt, +10% życia. Poza walką medytacja daje 1,5× Qi.", "qiPermille": 250, "qiRegen": 4, "guardPermille": 60, "scalingDamagePermille": {"spirit": 180}},
    "body": {"descriptionPl": "Furia: każdy przyjęty cios dodaje stos (maks. 10): +3% zadawanych i −2% otrzymywanych obrażeń na stos; pełna furia podwaja odbicie kontr. Do tego +25% życia, gardy i osłony +10 pkt, leczenie +5% maks. HP, techniki Siły +10%. Poza walką Qi z kroków.", "guardPermille": 100, "healPermille": 50, "scalingDamagePermille": {"strength": 100}},
    "flame": {"descriptionPl": "Żar: trafienia rozpalają żar (45%); 5 stosów wybucha za 12% maks. życia wroga i spala jego gardę na turę. Do tego krwawienie i podpalenie +50% obrażeń, efekty +10% szans, techniki Ducha +6%. Poza walką 250 Qi z miejsc Płomienia.", "bleedPermille": 500, "effectChancePermille": 100, "scalingDamagePermille": {"spirit": 60}},
    "poison": {"descriptionPl": "Toksyny: trafienia zaszczepiają jedną z 4 trucizn (45%): osłabienie, spowolnienie, kruchość, zatrucie (blokuje połowę leczenia); 3 różne naraz to Kwitnienie Jadu — wróg otrzymuje +25% obrażeń od wszystkiego. Do tego efekty +25% szans, techniki Zręczności +10%. Poza walką medytacja nocą (21–5) daje 2× Qi.", "effectChancePermille": 250, "scalingDamagePermille": {"agility": 100}}
